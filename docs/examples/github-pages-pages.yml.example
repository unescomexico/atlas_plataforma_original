# EJEMPLO DE REFERENCIA — NO SE EJECUTA AUTOMÁTICAMENTE DESDE ESTA RUTA.
#
# Si la Secretaría de Cultura decide desplegar mediante GitHub Pages + GitHub Actions,
# copiar este archivo a:
#   .github/workflows/pages.yml
#
# Antes de activarlo, el equipo responsable debe revisar permisos, rama de publicación,
# política de aprobaciones y configuración del entorno github-pages.

name: Security check and deploy Atlas to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  security_check:
    name: Atlas security check
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.13"

      - name: Run repository security check
        run: python scripts/security_check.py

  deploy:
    name: Deploy GitHub Pages
    needs: security_check
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    permissions:
      contents: read
      pages: write
      id-token: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload site artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: .

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
